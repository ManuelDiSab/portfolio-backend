# --- CONFIGURAZIONE DATABASE (ESEMPIO) ---
spring.datasource.url=jdbc:mysql://localhost:3306/nome_tuo_db?createDatabaseIfNotExist=true
spring.datasource.username=tuo_username
spring.datasource.password=tua_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- JPA / HIBERNATE ---
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# --- SICUREZZA / JWT ---
app.jwt-secret=inserisci_qui_una_chiave_segreta_molto_lunga
app.jwt-expiration-milliseconds=3600000

# --- DATI ADMIN ---
user.admin.username = admin
user.admin.password = password
user.admin.email = admin@example.com
